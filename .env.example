# Environment for the whole repository. The backend reads backend/.env (copy backend/.env.example);
# the frontend reads frontend/.env.local (copy frontend/.env.example). Feature 4 adds these backend variables:

# Web app URL used in email links and after Google/Apple sign-in (default: first FRONTEND_ORIGINS entry).
APP_URL=http://localhost:5173
# Public URL of the API function; the OAuth redirect URI is ${PUBLIC_API_URL}?action=oauthCallback.
PUBLIC_API_URL=http://127.0.0.1:3000/api/cacahuete
# Verification emails through Resend. Leave empty to print the link in the server console.
RESEND_API_KEY=
MAIL_FROM=Cacahuete <no-reply@example.com>
# Google sign-in (OAuth client of type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple sign-in: Services ID, team, key ID and the .p8 key (PKCS#8 PEM, newlines may be written as \n).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
