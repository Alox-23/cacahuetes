# Con el lanzador, deja DATABASE_URL sin definir para usar la base integrada.
# DATABASE_URL=postgresql://user:password@localhost:5432/cacahuete
# Solo al usar Vite en otro puerto:
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QUOTA_SECRET=
DEMO_SCENARIOS=true
PARTNER_PLACE_IDS=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Feature 4: web app URL used in email links and after Google/Apple sign-in (default: first FRONTEND_ORIGINS entry).
# APP_URL=http://localhost:5173
# Public URL of this function; the OAuth redirect URI is ${PUBLIC_API_URL}?action=oauthCallback.
# PUBLIC_API_URL=http://127.0.0.1:3000/api/cacahuete
# Verification emails through Resend. Leave empty to print the link in the server console.
RESEND_API_KEY=
MAIL_FROM=Cacahuete <no-reply@example.com>
# Google sign-in (OAuth client of type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple sign-in: Services ID, team, key ID and the .p8 key (PKCS#8 PEM, newlines may be written as \n).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

PORT=3000
OLLAMA_BASE_URL=http://localhost:11434/v1
# Narrator: writes every reply of Cacahuete.
OLLAMA_MODEL=qwen2.5:7b
# Feature 5, agent: decides which planner action each chat turn runs. If a turn is too slow, try qwen2.5:1.5b.
OLLAMA_AGENT_MODEL=qwen2.5:3b
# Limits (defaults shown). The queue and concurrency are shared by both models. If the narrator is too slow on
# a CPU-only laptop, use OLLAMA_MODEL=qwen2.5:3b and OLLAMA_TIMEOUT_MS=45000 (and raise OLLAMA_AGENT_BUDGET_MS, e.g. 60000).
# OLLAMA_AGENT_TIMEOUT_MS=15000
# Whole agent turn (queue waits and every model call); round 2 is skipped with less than 8 s left.
# OLLAMA_AGENT_BUDGET_MS=45000
# OLLAMA_TIMEOUT_MS=20000
# OLLAMA_QUEUE_MS=30000
# OLLAMA_CONCURRENCY=2
# Launcher only: what stopping it does to Ollama (started | always | never); it unloads both models.
# OLLAMA_STOP_ON_EXIT=started
